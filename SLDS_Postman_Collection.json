{
  "info": {
    "name": "SLDS Microservices System - Complete Postman Collection",
    "description": "Full API Collection for Smart Lending & Deposit System (SLDS)\nIncludes all 5 Microservices:\n1. Gateway & Auth Service\n2. Loan Service\n3. Deposit Service\n4. Credit Assessment Service\n5. Core Banking Adapter Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Service 1: API Gateway & Auth Service",
      "item": [
        {
          "name": "1.1 User Register (Lưu tạm Redis TTL 10 phút - Không ghi DB)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"linhnv_customer\",\n  \"email\": \"linhnv03@ominext.com\",\n  \"password\": \"BankSecure@2026\",\n  \"fullName\": \"Nguyễn Văn Linh\",\n  \"phone\": \"0988123456\",\n  \"role\": \"CUSTOMER\",\n  \"branchCode\": \"BRANCH_HO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Kiểm tra email/username chưa tồn tại. Lưu tạm thông tin User + OTP vào Redis với TTL = 10 phút (Key: pending_user:{email}). Không ghi Database để tránh rác DB."
          }
        },
        {
          "name": "1.2 Verify OTP & Hoàn tất Đăng ký (Insert DB + Cấp JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"linhnv03@ominext.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            },
            "description": "Đọc dữ liệu từ Redis theo Key. Nếu đúng OTP: INSERT thông tin User từ Redis vào PostgreSQL DB -> Xóa Key Redis -> Cấp token JWT đăng nhập thành công."
          }
        },
        {
          "name": "1.3 Resend OTP (Gia hạn 10 phút)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"linhnv03@ominext.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "resend-otp"]
            },
            "description": "Cấp lại mã OTP mới và gia hạn thêm 10 phút TTL trong Redis."
          }
        },
        {
          "name": "1.4 Login & Obtain JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"officer_linhnv\",\n  \"password\": \"BankSecret123!\",\n  \"role\": \"CREDIT_OFFICER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates user against Gateway Auth Service, generates JWT signed token, and caches session in Redis."
          }
        },
        {
          "name": "1.5 Logout & Blacklist Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Terminates active session and blacklists JWT token in Redis."
          }
        },
        {
          "name": "1.6 Validate JWT Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "validate"]
            },
            "description": "Verifies JWT signature and checks if session exists in Redis store."
          }
        }
      ]
    },
    {
      "name": "Service 2: Loan Microservice",
      "item": [
        {
          "name": "2.1 Create Loan Application (Publish Event to ActiveMQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicantId\": \"CUST-990812\",\n  \"applicantName\": \"Nguyễn Văn A\",\n  \"applicantCip\": \"001099887766\",\n  \"requestedAmount\": 500000000,\n  \"termMonths\": 24,\n  \"interestRate\": 8.5,\n  \"interestType\": \"REDUCING_BALANCE\",\n  \"purpose\": \"Vay mua ô tô kinh doanh\",\n  \"officerId\": \"OFFICER_01\",\n  \"branchCode\": \"BRANCH_HO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "applications"]
            },
            "description": "Creates a new loan application in PostgreSQL and publishes event to ActiveMQ 'loan.application.assessment'."
          }
        },
        {
          "name": "2.2 Loan Disbursement (Giải ngân khoản vay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationNo\": \"HS-VAY-88392019\",\n  \"disbursementAccount\": \"109283746500\",\n  \"loanAmount\": 500000000,\n  \"termMonths\": 12,\n  \"interestRate\": 8.5,\n  \"interestType\": \"REDUCING_BALANCE\",\n  \"disbursementChannel\": \"INTERNET_BANKING\",\n  \"officerId\": \"OFFICER_01\",\n  \"branchCode\": \"BRANCH_HO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/disburse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "disburse"]
            },
            "description": "Executes disbursement using Strategy Pattern, updates PostgreSQL, calls Core Banking with Circuit Breaker, and audits on Elasticsearch."
          }
        },
        {
          "name": "2.3 Repay Loan (Thu nợ khoản vay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractNo\": \"HDTD-19283746\",\n  \"repaymentAmount\": 45000000,\n  \"sourceAccount\": \"109283746500\",\n  \"tellerId\": \"TELLER_01\",\n  \"branchCode\": \"BRANCH_HO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/repay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "repay"]
            },
            "description": "Processes loan repayment, updates remaining principal/interest balance, and saves receipt."
          }
        },
        {
          "name": "2.4 Preview Repayment Schedule (Strategy Pattern)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/schedules/preview?amount=500000000&rate=8.5&termMonths=12&interestType=REDUCING_BALANCE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "schedules", "preview"],
              "query": [
                {
                  "key": "amount",
                  "value": "500000000"
                },
                {
                  "key": "rate",
                  "value": "8.5"
                },
                {
                  "key": "termMonths",
                  "value": "12"
                },
                {
                  "key": "interestType",
                  "value": "REDUCING_BALANCE"
                }
              ]
            },
            "description": "Generates preview repayment schedule using selected interest calculation strategy."
          }
        }
      ]
    },
    {
      "name": "Service 3: Deposit Microservice",
      "item": [
        {
          "name": "3.1 Get Deposit Products (Redis Cached Catalog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/deposits/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deposits", "products"]
            },
            "description": "Retrieves active deposit product catalog, cached in Redis for fast query speed."
          }
        },
        {
          "name": "3.2 Calculate Deposit Interest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 200000000,\n  \"annualRate\": 6.2,\n  \"termMonths\": 12,\n  \"actualDaysHeld\": 365,\n  \"payoutType\": \"AT_MATURITY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/deposits/schedules/calculate-interest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deposits", "schedules", "calculate-interest"]
            },
            "description": "Calculates estimated interest payouts for full term or early withdrawal."
          }
        },
        {
          "name": "3.3 Open Deposit Account (Mở sổ tiết kiệm)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-990812\",\n  \"customerName\": \"Nguyễn Văn A\",\n  \"productCode\": \"TK-ONLINE-12M\",\n  \"depositAmount\": 200000000,\n  \"termMonths\": 12,\n  \"interestRate\": 6.2,\n  \"payoutType\": \"AT_MATURITY\",\n  \"fundingAccount\": \"109283746500\",\n  \"branchCode\": \"BRANCH_HO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/deposits/accounts/open",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deposits", "accounts", "open"]
            },
            "description": "Opens a new deposit account (Sổ tiết kiệm) and registers interest payout rules."
          }
        },
        {
          "name": "3.4 Close Deposit Account (Tất toán sổ tiết kiệm)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"STK-1829304918\",\n  \"destinationAccount\": \"109283746500\",\n  \"tellerId\": \"TELLER_01\",\n  \"branchCode\": \"BRANCH_HO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/deposits/accounts/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deposits", "accounts", "close"]
            },
            "description": "Closes deposit account and calculates maturity or early-settlement interest."
          }
        },
        {
          "name": "3.5 Query Customer Deposit Accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/deposits/accounts/customer/CUST-990812",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deposits", "accounts", "customer", "CUST-990812"]
            },
            "description": "Lists all active/closed deposit accounts owned by a customer ID."
          }
        }
      ]
    },
    {
      "name": "Service 4: Credit Assessment Microservice",
      "item": [
        {
          "name": "4.1 Evaluate Credit Score & CIC (Synchronous REST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationNo\": \"HS-VAY-88392019\",\n  \"applicantId\": \"CUST-990812\",\n  \"applicantName\": \"Nguyễn Văn A\",\n  \"applicantCip\": \"001099887766\",\n  \"requestedAmount\": 500000000,\n  \"termMonths\": 24,\n  \"eventTimestamp\": \"2026-08-11T21:30:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/assessment/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assessment", "evaluate"]
            },
            "description": "Evaluates credit score (300-850), queries CIC bad debt group, and indexes result in Elasticsearch."
          }
        },
        {
          "name": "4.2 Query CIC Bad Debt History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/assessment/cic/001099887766",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assessment", "cic", "001099887766"]
            },
            "description": "Simulates querying Vietnam CIC database for bad debt history."
          }
        },
        {
          "name": "4.3 Search Credit Audit Logs (Elasticsearch)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/assessment/logs?query=001099887766",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assessment", "logs"],
              "query": [
                {
                  "key": "query",
                  "value": "001099887766"
                }
              ]
            },
            "description": "Searches credit scoring audit logs indexed in Elasticsearch."
          }
        }
      ]
    },
    {
      "name": "Service 5: Core Banking Adapter Microservice",
      "item": [
        {
          "name": "5.1 Post Core Banking Journal (Resilience4j Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journalType\": \"LOAN_DISBURSEMENT\",\n  \"debitAccount\": \"GL-NO-VAY-1001\",\n  \"creditAccount\": \"109283746500\",\n  \"amount\": 500000000,\n  \"narrative\": \"Hạch toán giải ngân khoản vay HDTD-19283746\",\n  \"referenceNo\": \"HS-VAY-88392019\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/core-banking/journals/post",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "core-banking", "journals", "post"]
            },
            "description": "Executes posting to Oracle DB Core Banking layer protected by Resilience4j Circuit Breaker."
          }
        },
        {
          "name": "5.2 Query Core Banking Account Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/core-banking/accounts/109283746500/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "core-banking", "accounts", "109283746500", "balance"]
            },
            "description": "Queries real-time available balance from Core Banking Oracle DB."
          }
        },
        {
          "name": "5.3 Get Circuit Breaker Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/core-banking/circuit-breaker/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "core-banking", "circuit-breaker", "status"]
            },
            "description": "Checks whether Resilience4j Circuit Breaker state is CLOSED (Healthy) or OPEN (Fallback Queue)."
          }
        },
        {
          "name": "5.4 Toggle Core Banking Failure Simulation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"simulateError\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/core-banking/circuit-breaker/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "core-banking", "circuit-breaker", "toggle"]
            },
            "description": "Toggles Core Banking Oracle DB timeout failure simulation to test Circuit Breaker activation."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "eyJhbGciOiJIUzI1NiJ9.slds_jwt_session_officer_linhnv",
      "type": "string"
    }
  ]
}
